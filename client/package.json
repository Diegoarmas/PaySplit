  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "export CHROME_BIN=$(node -e \"Promise.resolve(require('puppeteer').executablePath()).then(console.log)\") && ng test --browsers=ChromeHeadlessNoSandbox",
    "test:jest": "jest",
    "test:jest:coverage": "jest --coverage",
    "test:ci": "export CHROME_BIN=$(node -e \"Promise.resolve(require('puppeteer').executablePath()).then(console.log)\") && ng test --watch=false --browsers=ChromeHeadlessNoSandbox",
    "serve:ssr:client": "node dist/client/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.26",
